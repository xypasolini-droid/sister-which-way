<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device" compressed="false">
  <diagram id="early" name="01 前五次选择（经历与汇流）">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;姐姐，我该怎么走 · 0.5.1 当前决策树&lt;/b&gt;&lt;br/&gt;第1–5次：每个白框是一个实际选项，保留屏幕顺序。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#454545;fontSize=17;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="90" as="geometry" />
        </mxCell>
        <object id="n01" label="&lt;b&gt;第1次 · n01&lt;/b&gt;&lt;br/&gt;巡查停在父亲的摊前" tooltip="清晨，父亲借着腋拐在市场的旧毯上坐下，慢慢收拢双腿，把拐靠在身旁。他走路有些跛，站起时需要支撑，仍替不识字的人读信、卖家里能割舍的东西。你十二岁，坐在他身旁数纽扣。一个加入武装巡查的年轻旧生认出了他，却不肯再叫老师。&#10;那人指着你的脸，呵斥父亲不该带女孩来摆摊。父亲叫出他从前的名字，他的脸涨红了。同来的年长看守阿明站在几步外，没有阻止他把手伸向武器。&#10;父亲把你挡到身后，提醒你不要争辩。你把话咽下去，攥紧故事册。那人说会记住你们住在哪里；父亲收毯子的手停了一下，再把掉落的纽扣一颗颗拾起来。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="140" width="340" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="n01_work" label="&lt;b&gt;01&lt;/b&gt;　蹲下来，帮父亲捡起摊上的东西&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n01 / work&lt;/font&gt;" tooltip="纽扣滚到了巡查脚边。父亲低声叫你别争，先把毯子收起来。&#10;&#10;后果：你蹲下捡纽扣，伸到巡查靴边的手又缩回来。父亲把最后几件旧物裹进毯子，撑着腋拐站起：“走吧。”那人一直盯着你们离开的方向。傍晚，全家围着饭碗坐下，门外响起白天那人的声音。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="270" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n01" target="n01_work">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n01_work" target="n02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n01_neighbor" label="&lt;b&gt;02&lt;/b&gt;　看向卖饼的熟人：“能帮帮我们吗？”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n01 / neighbor&lt;/font&gt;" tooltip="你认得他，也认得他忽然移开的目光。巡查还站在摊前。&#10;&#10;后果：卖饼的熟人看了看武器，低下头，把捡到的布包悄悄递还父亲。他没敢再说话。父亲牵你离开，你没有再叫他。傍晚回到家，饭刚端上来，白天威胁你们的人就在门外喊父亲的名字。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="270" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n01" target="n01_neighbor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n01_neighbor" target="n02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n01_mother" label="&lt;b&gt;03&lt;/b&gt;　靠近父亲，小声问：“是我的错吗？”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n01 / mother&lt;/font&gt;" tooltip="巡查说女孩不该来。你把故事册抱紧，不敢再抬头。&#10;&#10;后果：父亲把手放在你的肩上：“不是你的错。”他没再与巡查争辩，收好故事册和旧物，撑拐带你回家。你以为关上家门就能躲过那道目光。傍晚，萨米刚挨到父亲身旁，门却被狠狠踢响。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="970" y="270" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n01" target="n01_mother">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n01_mother" target="n02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n02" label="&lt;b&gt;第2次 · n02&lt;/b&gt;&lt;br/&gt;傍晚，被踢开的门" tooltip="饭刚放下，家门就被踢开。白天在市场威胁父亲的年轻巡查带人闯进来，指着他喊要带走。母亲从地毯旁扑过去，玛莉安把三岁的萨米抱紧，你挡在父亲身前。&#10;武装者把父亲拉向门口，没让他稳住腋拐。母亲抓住他的衣袖，又被推回；水碗翻了，父亲的外衣还搭在墙边。你喊他们放手，父亲隔着伸来的手让你退到母亲身旁。他是在全家眼前被强行带走的。&#10;门外的人丢下一句父亲会被关进拘留院。脚步声远去后，母亲捡起写着丈夫名字的纸，说明早去要求放人。姐姐答应留在屋里看萨米；你要跟母亲一起去。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="440" width="340" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="n02_cut" label="&lt;b&gt;01&lt;/b&gt;　跟上母亲：“我和你一起去找爸爸。”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n02 / cut&lt;/font&gt;" tooltip="母亲要去监所要求放人；姐姐留下照看萨米。&#10;&#10;后果：你陪母亲去拘留院要求放人，姐姐留家照看萨米。街口巡查指责母女没有成年男性亲属陪同，母亲的话没说完，棍子已落下来。你扶她回家养伤，随后独自买饼，却被推回零钱、追赶着空手归来。萨米问有钱为什么没有饭，你答不上来，只陪他讲完火苗守住名字的故事。姐姐打开亡兄的衣箱，把剪刀放在你面前。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="310" y="570" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n02" target="n02_cut">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n02_cut" target="n06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n02_sew" label="&lt;b&gt;02&lt;/b&gt;　抱抱姐姐：“要是晚了，别出来找我们。”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n02 / sew&lt;/font&gt;" tooltip="请她托法里达打听，再跟上母亲。你怕她也走到巡查面前。&#10;&#10;后果：出门前，你抱住姐姐，约好晚了就请法里达传话，别独自走到街上。街口巡查指责母女没有成年男性亲属陪同，母亲的话没说完，棍子已落下来。你扶她回家养伤，随后独自买饼，却被推回零钱、追赶着空手归来。萨米问有钱为什么没有饭，你答不上来，只陪他讲完火苗守住名字的故事。姐姐打开亡兄的衣箱，把剪刀放在你面前。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="750" y="570" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n02" target="n02_sew">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n02_sew" target="n06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="transition" value="自动过场：母亲寻父被打 → 在家养伤 → 女主独自购食被拒 → 讲火苗故事。&lt;br/&gt;这些是固定事件，不是额外的玩家选择。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#454545;fontSize=17;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="90" y="710" width="1220" height="80" as="geometry" />
        </mxCell>
        <object id="n06" label="&lt;b&gt;第3次 · n06&lt;/b&gt;&lt;br/&gt;姐姐把剪刀放在你面前" tooltip="这几天，母亲带你要求释放父亲，被巡查以没有成年男性亲属陪同为由殴打；她回家养伤。你偷偷买饼，被拒绝、追赶，带着仍未花掉的钱空手回家。萨米听完火苗的故事，还是饿。&#10;姐姐打开亡兄阿里的衣箱。灰白长衫、宽裤和朴素小帽压在最下面。穿成男孩或许能接过一枚钱，却不能让饥饿、武器和战争消失。她把剪刀放低，等你决定怎样开始。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="830" width="340" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="n06_buy" label="&lt;b&gt;01&lt;/b&gt;　把剪刀递给姐姐：“你来吧。”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n06 / buy&lt;/font&gt;" tooltip="你闭上眼睛，请她先握一会儿你的手，再剪下发辫。&#10;&#10;后果：发辫落下时你哭了。姐姐等你哭完，用红线扎好，把原来的衣服收进箱子。你穿上阿里的长衫、宽裤和小帽，准备借一个被当作男孩的名字出门；母亲伸手叫住你，仍叫努拉。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="310" y="960" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n06" target="n06_buy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n06_buy" target="n07">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n06_help" label="&lt;b&gt;02&lt;/b&gt;　接过剪刀：“最后这一下，我自己来。”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n06 / help&lt;/font&gt;" tooltip="姐姐先剪下一束，再陪着你剪完。亡兄的长衫、宽裤和小帽就在身旁。&#10;&#10;后果：姐姐先剪一束，再把剪刀交给你。最后几刀并不齐，你也没有重新剪到完美。阿里的旧衣服有些大，小帽却戴稳了；你把真名留在家人的声音里，没有答应从此不再害怕。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="750" y="960" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n06" target="n06_help">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n06_help" target="n07">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n07" label="&lt;b&gt;第4次 · n07&lt;/b&gt;&lt;br/&gt;莱拉认出了你" tooltip="这次，摊主把饼和零钱递给了你。一个戴小帽的小帮工却叫出了你的真名，直到认出是以前一起上课的莱拉，你才松开攥紧的钱。她也借男孩的身份跑腿挣钱。&#10;莱拉说在街上还得有一个名字。你想起讲给弟弟的火苗，决定叫阿提什——火焰。回家以后仍叫努拉，这两个名字都装着你想活下去的心愿。&#10;莱拉指给你看几处肯雇小帮工的门。她自己也要送货、养家，不能一直陪着你。你把饼藏好：姐姐和萨米还在等。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="1120" width="340" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="n07_truth" label="&lt;b&gt;01&lt;/b&gt;　跟莱拉去市场，替人送货读信&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n07 / truth&lt;/font&gt;" tooltip="你们结伴跑腿。先把买到的饼送回家，再去摆摊。&#10;&#10;后果：莱拉带你绕开拦人的街口，一起送完几份货。你把挣来的饼送回家，再回到摊前替人读信。阿明捏着一封信等在那里；你认出他曾站在抓走父亲的人身旁，脚先退了半步。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="1250" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n07" target="n07_truth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n07_truth" target="n09">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n07_hide" label="&lt;b&gt;02&lt;/b&gt;　跟莱拉去作坊，问问有没有修补活&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n07 / hide&lt;/font&gt;" tooltip="你会缝几针。莱拉带你敲后门，再去送她自己的货。&#10;&#10;后果：莱拉把你领到裁缝后门。老板让你坐下补衣，她去别处送货，答应回来接你。你先把买到的饼送回家，再坐到后间的矮凳上；学校里的同学，如今只能这样在街上相认。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="1250" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n07" target="n07_hide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n07_hide" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n07_pact" label="&lt;b&gt;03&lt;/b&gt;　先把饼带回家，告诉姐姐遇见了莱拉&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n07 / pact&lt;/font&gt;" tooltip="她还不知道你在外面叫阿提什。回去时，你想让她先吃一点。&#10;&#10;后果：莱拉带你认过愿意开后门的熟人，再去照顾她自己的家。你把饼带回去，告诉姐姐在外面叫阿提什——火焰。她没有因你能挣钱便放心，先问下次要去哪儿、几点回来。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="970" y="1250" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n07" target="n07_pact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n07_pact" target="n13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n09" label="&lt;b&gt;第5次 · n09&lt;/b&gt;&lt;br/&gt;他想再听一次妻子的名字" tooltip="面包摊后门，阿明递来一封信。你认出他曾站在年轻巡查身旁，脚先往后退了半步。信里说，他的妻子哈拉去参加妹妹婚礼，乘坐的巴士触了地雷；她受了重伤，几个小时后去世。你读到这里，声音慢下来。&#10;阿明削苹果的手停住了。过了很久，他才让你把哈拉的名字再念一遍。你没有接着问父亲，只把那几个字指给他看，陪他坐了一会儿。莱拉在门边等你，姐姐留在私宅照顾母亲和萨米。&#10;他把信重新折好，贴身收起。你没有忘记他曾站在哪些人身旁，也没有因为看见他的悲痛就相信他。可此刻他想念的是一个再也不能回家的人，你愿意让她的名字被好好念完。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="1430" width="340" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="n09_verify" label="&lt;b&gt;01&lt;/b&gt;　把信还给他，轻声问起父亲&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n09 / verify&lt;/font&gt;" tooltip="等他缓过来，再另拿一张纸写父亲的名字；别催他拿这封信做交换。&#10;&#10;后果：你把信还给阿明，陪他静坐了一会儿。稍后再见，才在另一张纸上写下父亲的名字。他对照轮值纸，确认父亲仍在北门拘留院，没有答应探视。哈拉的信仍由阿明收着，你把问得的地点带回家；知道关在哪里，和能把人救回家，仍隔着一道铁门。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="1560" width="340" height="105" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n09" target="n09_verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n09_verify" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n09_courier" label="&lt;b&gt;02&lt;/b&gt;　再念一遍哈拉的名字，陪他认字&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n09 / courier&lt;/font&gt;" tooltip="接下来的几次送货都停一会儿。你少接了几份活，阿明才慢慢愿意与你说话。&#10;&#10;后果：接下来的几次送货，阿明都请你再念一次妻子哈拉的名字。你陪他练写，他终于能自己认出来。后来你才另拿一张纸写下父亲的姓名，他记下了，阿齐兹也愿意递消息。你回家商量，有了几次真实的往来，仍没有放人的保证。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="1695" width="340" height="105" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n09" target="n09_courier">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n09_courier" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n09_sister" label="&lt;b&gt;03&lt;/b&gt;　今天先不问父亲，收摊回家&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n09 / sister&lt;/font&gt;" tooltip="把哈拉的信还给阿明。你不知道该怎样安慰他，也想回去看看母亲。&#10;&#10;后果：你把信还给阿明，带着自己的见闻回家，告诉姐姐他想念妻子哈拉。她与你沉默了一会儿，再核对下一次能找谁问父亲。母亲把夜里写给远亲的信推到灯下，另一个求生的办法也需要有人说清代价。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="1830" width="340" height="105" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n09" target="n09_sister">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n09_sister" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n10" label="&lt;b&gt;第5次 · n10&lt;/b&gt;&lt;br/&gt;工钱与名字" tooltip="莱拉介绍的作坊后间堆着从各家收来的衣服。拉希德让你避开前窗做活；留着女孩身份的妇人只能隔着帘子交货，一笔报酬又被送货人扣下了。莱拉送完货回到后门，与你一起听见女工争辩。&#10;你能先挣自己的钱，也能征得女工同意后帮她把账说清。莱拉也等着她那一份，她提醒你老板肯用小帮工，不等于会公平付钱，更不等于孩子从此不受胁迫。&#10;送货人把她做坏一针的衣服摊开，说整件都不能算钱。衣领早被别人穿脏了。女工隔着门帘问是不是连线的钱也没有，对方让她小声些，别给自己招来麻烦。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="1430" width="340" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="n10_wage" label="&lt;b&gt;01&lt;/b&gt;　扶住被推的女工，和她一起退到门外&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n10 / wage&lt;/font&gt;" tooltip="老板伸手推她，你扶住她往门外退；自己今天的报酬也可能拿不到。&#10;&#10;后果：老板伸手推搡不肯认账的女工。你挡到她身前，莱拉拉开门，三个人一起退进巷子。她稳住身体后让你别再回去争；你的活也没拿到报酬。你把遭遇照实告诉家人，母亲摊开那封寄给远亲的信：她已向优素福求接应，却还没收到回话。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="1560" width="340" height="105" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n10" target="n10_wage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n10_wage" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n10_ledger" label="&lt;b&gt;02&lt;/b&gt;　拉开后门，叫莱拉过来帮忙&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n10 / ledger&lt;/font&gt;" tooltip="先让她们进出有路。你不想再与老板争下去，也知道这份活可能做不成了。&#10;&#10;后果：你拉开后门，叫回刚送完货的莱拉。她扶住女工，你从另一边护着她退出作坊。老板在身后骂你们别再回来。女工不肯丢下那件缝好的衣服，你替她包起，送她走到熟悉的街角才回家；母亲还在等你带回晚饭。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="1695" width="340" height="105" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n10" target="n10_ledger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n10_ledger" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n13" label="&lt;b&gt;第5次 · n13&lt;/b&gt;&lt;br/&gt;姐姐也有不能答应的事" tooltip="姐姐发现你把一张纸藏在床垫下。她没有先看内容，而是坐到你对面：“明天你还准备瞒我什么？”母亲的咳嗽从隔壁传来。&#10;你忽然觉得，姐姐的担心和街上的命令一样，都在拦着你。她却第一次说出了自己的计划：找一个能让女孩继续读书的地方。&#10;你冲她喊：“你又不是母亲！”话出去以后屋里很静。姐姐去捡掉在地上的线，捡了两次才拿起来。她十七岁，昨夜也曾躲在水盆边哭，只是你没有看见。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="970" y="1430" width="340" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="n13_listen" label="&lt;b&gt;01&lt;/b&gt;　坐到姐姐身旁：“你也很害怕吧？”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n13 / listen&lt;/font&gt;" tooltip="先听她把话说完。你们一起说好，下次要去哪里、什么时候回来。&#10;&#10;后果：你先道歉，再把纸摊开。姐姐没有立刻原谅，只把自己想继续读书的地方也写上去。你们仍不同意同一条路，但第一次没有用提高声音来逼对方把愿望划掉。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="970" y="1560" width="340" height="105" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13" target="n13_listen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13_listen" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n13_secret" label="&lt;b&gt;02&lt;/b&gt;　把饼放下：“我还得出去一趟。”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n13 / secret&lt;/font&gt;" tooltip="你不愿再说街上发生的事。姐姐叫你等等，你还是走向了门口。&#10;&#10;后果：你没有把话说清。姐姐、母亲和萨米先住法里达相连的里间，你去作坊做工，不能再把她会等在原处当成理所当然。广播说路快封了；法里达转来母亲的信，你才知道她还试着用一桩婚事向远亲求照应。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="970" y="1695" width="340" height="105" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13" target="n13_secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13_secret" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n13_care" label="&lt;b&gt;03&lt;/b&gt;　接过水盆：“你歇一会儿，我来照看母亲。”&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n13 / care&lt;/font&gt;" tooltip="姐姐一夜没睡。你留下换水喂药，今天不再出去找活。&#10;&#10;后果：你接过水盆，让姐姐终于坐下。母亲喝了水，伤仍在；关于明天的争执也没有消失。夜里广播说道路快封锁，母亲把写给远亲的信拿出来，这一次不能再只让一个人决定全家的去路。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="970" y="1830" width="340" height="105" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13" target="n13_care">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13_care" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n18" label="&lt;b&gt;第6次 · n18&lt;/b&gt;&lt;br/&gt;母亲说，舅舅的车快到了" tooltip="你赶回法里达的里间时，母亲和姐姐都在。母亲曾想用玛莉安的婚事求贾维德照应，姐姐不肯答应。如今贾维德借战事上门逼人走，母亲终于回绝了他。亲弟优素福传来消息：他今天能先接一趟，封关前还会再跑最后一趟，之后就不能折返。&#10;父亲还在北门。去那里不能敲一次门就把人接出来：你得和姐姐约好接应，再花几天与阿明读信、教字，家人也要承受等待。莱拉托人说市场开始拦人，她仍没能回家。你可以先赶回家人的车，也可以回街上找她。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="530" y="2040" width="340" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="truth" value="当前结构：前五次的所有96种行动前缀都汇到这里，仍能通往全部五个结局。&lt;br/&gt;数值和经历不同，但没有结局门槛。接下页「02 最后两次选择」。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#454545;fontSize=17;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="90" y="2200" width="1220" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="late" name="02 最后两次选择（五种命运）">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;第6、7次：当前真正决定命运的分支&lt;/b&gt;&lt;br/&gt;从上一页n18接入；所有选项都可直接执行，没有隐藏数值门槛。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#454545;fontSize=17;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="100" as="geometry" />
        </mxCell>
        <object id="n18" label="&lt;b&gt;第6次 · n18&lt;/b&gt;&lt;br/&gt;母亲说，舅舅的车快到了" tooltip="你赶回法里达的里间时，母亲和姐姐都在。母亲曾想用玛莉安的婚事求贾维德照应，姐姐不肯答应。如今贾维德借战事上门逼人走，母亲终于回绝了他。亲弟优素福传来消息：他今天能先接一趟，封关前还会再跑最后一趟，之后就不能折返。&#10;父亲还在北门。去那里不能敲一次门就把人接出来：你得和姐姐约好接应，再花几天与阿明读信、教字，家人也要承受等待。莱拉托人说市场开始拦人，她仍没能回家。你可以先赶回家人的车，也可以回街上找她。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="770" y="160" width="400" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="n18_plan" label="&lt;b&gt;01&lt;/b&gt;　和姐姐约好接应，再去北门找阿明&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n18 / plan&lt;/font&gt;" tooltip="想救父亲，得先不随今天的车走。接下来用几次送货的时间陪阿明读信、教字，等侧门出现机会；家人也得多等几天。&#10;&#10;后果：你向姐姐把去向说清，补上此前没有守住的约定；她确认会守着法里达的后门接应。母亲拒绝贾维德的强迫，告诉优素福今天先不走。接下来的几次送货，你从替阿明读信开始，陪他一笔笔认写妻子哈拉的名字，等他愿意谈起自己的家。几次往来以后，你才在另一张纸上写下父亲的姓名。这些天你少接了许多活，家人分着剩下的饼，错过较早的离城车。直到炮火逼近、关口将封的那一夜，阿明才托人带来侧门换岗的消息；优素福也来跑最后一趟。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="310" width="400" height="120" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18" target="n18_plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18_plan" target="n25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n18_find" label="&lt;b&gt;02&lt;/b&gt;　陪母亲上车，和家人一起离开&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n18 / find&lt;/font&gt;" tooltip="不再往北门跑，父亲暂时接不出来。帮母亲摆脱贾维德，和姐姐、萨米随优素福离开。&#10;&#10;后果：你去问母亲的亲弟优素福有没有回信，家人留在关门的住处。贾维德却趁你不在开着红色轿车提前到了，借战事催母亲、姐姐和萨米上车。母亲反复说还有一个女儿没回来，他不肯等；接下来的决定，由她们自己作出。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="770" y="310" width="400" height="120" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18" target="n18_find">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18_find" target="n21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n18_rush" label="&lt;b&gt;03&lt;/b&gt;　告诉家人别等我，回街上找莱拉&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n18 / rush&lt;/font&gt;" tooltip="莱拉被堵在市场。你要回去接她，就得放下去监所和跟家人登车的机会。&#10;&#10;后果：优素福亲自赶到私院，母亲拒绝贾维德的逼婚，决定带姐姐和萨米跟亲弟离城。你告诉她们自己要去找被堵住的莱拉：“封关了就走，不要等。”姐姐先与你确认这真是你的决定，再把手松开。你沿市场侧巷去找莱拉。家人的车已经出发，父亲仍在监所。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="1450" y="310" width="400" height="120" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18" target="n18_rush">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18_rush" target="n22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n25" label="&lt;b&gt;第7次 · n25&lt;/b&gt;&lt;br/&gt;在铁门和战火之间" tooltip="几天过去。哈拉的信仍由阿明收着，你教过的字，他已经能慢慢读出来。父亲的姓名另写在一张纸上。他终于打听到侧门的换岗，约你在炮火间歇时等；这次帮忙仍可能让他丢掉性命。&#10;姐姐收到了你再次确认的回话，守着法里达的后门。优素福最后一趟车也到了，莱拉却被堵在市场另一头。你现在留在侧门救父，就会错过车；赶回去仍能登车，回头接莱拉则要让家人先走。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="520" width="400" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="n25_release" label="&lt;b&gt;01&lt;/b&gt;　留在侧门，接住阿明带出来的父亲&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n25 / release&lt;/font&gt;" tooltip="几天的准备等到了这一刻。接父亲上木车，就赶不上舅舅最后一趟车；家人会在后门等你。&#10;&#10;后果：阿明认出了你教过的字。炮火与调动声中，他负伤把父亲带出侧门，安置到借来的木推车上。父亲平日跛行，需要腋拐支撑，如今添了重伤，暂时不能自己撑拐行走。你握紧车把，朝先前与姐姐约定的门推去。母亲拒绝贾维德的强迫，已带萨米返回，姐姐也守在那里。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="710" width="400" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n25" target="n25_release">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n25_release" target="end_reunited">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n25_letter" label="&lt;b&gt;02&lt;/b&gt;　离开北门，赶回去与家人一起登车&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n25 / letter&lt;/font&gt;" tooltip="放弃今天的救父机会，四人随优素福离城；父亲仍留在铁门后。&#10;&#10;后果：你先回到约定的私院。母亲已经带着姐姐和萨米拒绝贾维德的强迫，优素福本人也赶到了。他核对去向与家人，替母亲找好能坐低的地方。你们四人登上露天后斗货车，握住栏板；父亲仍被关着。莱拉托人说会与熟悉的同伴走另一条路，你们不能保证她也能离开。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="870" width="400" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n25" target="n25_letter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n25_letter" target="end_caravan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n25_leave" label="&lt;b&gt;03&lt;/b&gt;　送家人上车，回头去接被堵住的莱拉&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n25 / leave&lt;/font&gt;" tooltip="先明确告诉家人不要等。回头接她，可能让你再也赶不上这趟车。&#10;&#10;后果：你先把母亲、姐姐和萨米送到优素福亲自接应的露天货车旁。街口传来莱拉被堵住的消息。你告诉姐姐：“我去接她。封关了就走，不要回头等我。”她反复确认你的话，紧握过你的手才上车。你折返把莱拉拉进侧巷；关卡随即封闭，车已不得不开走。母亲、姐姐与幼弟离了城，你与莱拉留在另一边，父亲仍未获救。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="90" y="1030" width="400" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n25" target="n25_leave">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n25_leave" target="end_lantern">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n21" label="&lt;b&gt;第7次 · n21&lt;/b&gt;&lt;br/&gt;车在等，另一头有人叫你" tooltip="母亲拿起灶边的木棍，逼贾维德退开：“我女儿没有答应！”她带姐姐和萨米回到私院，与你会合。优素福已经到场，确认过落脚处，不拿婚约作交换。&#10;露天货斗里有母亲和幼弟坐的位置。姐姐伸手拉你，送信人却跑来，说莱拉被截在市场侧巷。车得在封关前走。你若回头，家人不能留下来替你承担同一次危险。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="770" y="520" width="400" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="n21_register" label="&lt;b&gt;01&lt;/b&gt;　握住姐姐的手，四个人一起上车&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n21 / register&lt;/font&gt;" tooltip="与母亲、姐姐、幼弟随优素福离城，父亲仍在监所。&#10;&#10;后果：你先回到约定的私院。母亲已经带着姐姐和萨米拒绝贾维德的强迫，优素福本人也赶到了。他核对去向与家人，替母亲找好能坐低的地方。你们四人登上露天后斗货车，握住栏板；父亲仍被关着。莱拉托人说会与熟悉的同伴走另一条路，你们不能保证她也能离开。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="770" y="710" width="400" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n21" target="n21_register">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n21_register" target="end_caravan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n21_child" label="&lt;b&gt;02&lt;/b&gt;　先送家人上车，我回头接莱拉&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n21 / child&lt;/font&gt;" tooltip="告诉姐姐封关就走。把被堵住的莱拉接回来，可能赶不上这趟车。&#10;&#10;后果：你先把母亲、姐姐和萨米送到优素福亲自接应的露天货车旁。街口传来莱拉被堵住的消息。你告诉姐姐：“我去接她。封关了就走，不要回头等我。”她反复确认你的话，紧握过你的手才上车。你折返把莱拉拉进侧巷；关卡随即封闭，车已不得不开走。母亲、姐姐与幼弟离了城，你与莱拉留在另一边，父亲仍未获救。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="770" y="870" width="400" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n21" target="n21_child">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n21_child" target="end_lantern">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n22" label="&lt;b&gt;第7次 · n22&lt;/b&gt;&lt;br/&gt;两个女孩，和一扇还开着的门" tooltip="你找到莱拉时，她正护着两个被巡查赶离街口的女孩。法里达让侧门开了一线，屋里只能暂时藏身。你们得先把人带进去。&#10;家人的车已经走了，父亲仍被囚。莱拉看着你：“先带她们躲进去。然后呢？”你想起那个讲给萨米的火苗故事：接下来是继续找路，还是在门后讲一段长大以后、不必再躲藏的童话？成年童话里的自由不会改变现实中的分别。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontColor=#202020;fontSize=17;fontStyle=1;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="1450" y="520" width="400" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="n22_school" label="&lt;b&gt;01&lt;/b&gt;　教女孩写下真名，让她们自己讲故事&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n22 / school&lt;/font&gt;" tooltip="先带她们藏进门里。等脚步远去，再教她们写名字，续讲火苗长大、与女人们一起办学校的成年童话。&#10;&#10;后果：你和莱拉先把女孩们安顿进受邀请的里间，听她们说出自己的名字，再陪不会写字的孩子画第一笔。母亲、姐姐和萨米已随优素福离城，父亲仍在监所。你续写火苗和许多人一起建城的故事，把学校、市场与议事的长桌放进成年之梦；梦没有让现实家人突然团聚。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="1450" y="710" width="400" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n22" target="n22_school">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n22_school" target="end_dream_commons">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n22_father" label="&lt;b&gt;02&lt;/b&gt;　挡在女孩身前，让莱拉带她们进门&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n22 / father&lt;/font&gt;" tooltip="你留下挡住追来的目光，让她们先进去。门合上后，接着讲火苗长大、守护女孩的成年童话。&#10;&#10;后果：你挡住侧门，让莱拉先把两个女孩送进里间，再一起把门关上。母亲、姐姐和萨米已随优素福离城，父亲仍在监所。你们躲在门后续写火苗的故事：如果有一天不必再退开，长大的她会怎样守住这条路？故事把时间带到成年，没有替现实的人撤去伤和失散。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="1450" y="870" width="400" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n22" target="n22_father">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n22_father" target="end_dream_guardian">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="n22_send" label="&lt;b&gt;03&lt;/b&gt;　牵住莱拉，带女孩们先穿过这条巷子&lt;br/&gt;&lt;font color=&quot;#777777&quot;&gt;n22 / send&lt;/font&gt;" tooltip="家人的车不再等你。你和莱拉留下相互接应，接着学会怎样带人过路。&#10;&#10;后果：你与莱拉把女孩们带到受邀请的里间，自己再退回侧巷找下一条路。优素福的车在封关前带母亲、姐姐和萨米离开；没有人答应你们何时重逢。你没有救出父亲，也没有赶上车，留下的两个人开始一起认路、一起活下去。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#202020;fontSize=16;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="1450" y="1030" width="400" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n22" target="n22_send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n22_send" target="end_lantern">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="north-note" value="北门：花数日准备，等侧门机会。&lt;br/&gt;去救父会错过最后离城车。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#454545;fontSize=17;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="90" y="1170" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="truck-note" value="货车：今天先走的一趟。&lt;br/&gt;回头接莱拉，就可能赶不上。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#454545;fontSize=17;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="770" y="1170" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="girls-note" value="女孩：家人已走，父亲仍被囚。&lt;br/&gt;实际选项顺序是05／04／03。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#454545;fontSize=17;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1170" width="400" height="90" as="geometry" />
        </mxCell>
        <object id="end_reunited" label="&lt;b&gt;01 · 这次，我带你回家&lt;/b&gt;&lt;br/&gt;你推着受伤的父亲穿过夜路。姐姐接住另一边车把，母亲与幼弟就在约好的门内。五个人重新聚齐。" tooltip="父亲和阿明仍有重伤；你们错过离城的车，必须在战事中共同照护家人。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0EB;strokeColor=#65776A;fontColor=#202020;fontSize=17;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="30" y="1450" width="360" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="end_caravan" label="&lt;b&gt;02 · 离城的四个人&lt;/b&gt;&lt;br/&gt;你拉住姐姐的手，随母亲与萨米坐进亲舅舅的露天货斗。四个人越过关口，父亲留在铁门后。" tooltip="父亲没有获救，莱拉也没有与你登上同一辆车。离开保住了四个人，没有把留下的人一并救走。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0EB;strokeColor=#65776A;fontColor=#202020;fontSize=17;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="460" y="1450" width="360" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="end_lantern" label="&lt;b&gt;03 · 回头的人&lt;/b&gt;&lt;br/&gt;你折返接住莱拉，错过家人的车。几年后的原创延展里，你们成为秘密山路上的引路人。" tooltip="母亲、姐姐和幼弟已随舅舅离城；父亲未能救出。你与莱拉留下，重逢没有保证，接应他人也始终危险。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0EB;strokeColor=#65776A;fontColor=#202020;fontSize=17;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="890" y="1450" width="360" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="end_dream_guardian" label="&lt;b&gt;04 · 守护之地&lt;/b&gt;&lt;br/&gt;【成年童话】&lt;br/&gt;成年童话：你成为全女性卫队的首领，守住女性自己决定生活的土地，让女孩从你身后走向学校。" tooltip="现实中，母亲、姐姐与幼弟随舅舅离城，父亲未获救，你与莱拉仍留在城里；成年梦境没有改写这些事实。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAF5;strokeColor=#88779E;fontColor=#202020;fontSize=17;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="1320" y="1450" width="360" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="end_dream_commons" label="&lt;b&gt;05 · 没有锁的明天&lt;/b&gt;&lt;br/&gt;【成年童话】&lt;br/&gt;成年童话：姐姐打开学校，莱拉经营铺子，你与女人们建立议事庭。女孩可以当街写下自己的真名。" tooltip="现实中，母亲、姐姐与幼弟已离城，父亲仍被囚，你与莱拉留在城里；梦中的团聚与自由没有被当作已经发生的历史。">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAF5;strokeColor=#88779E;fontColor=#202020;fontSize=17;spacing=14;" vertex="1" parent="1">
            <mxGeometry x="1750" y="1450" width="360" height="220" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="end-note" value="第七次选中即结算，没有额外的「下一步」。04、05的自由是明确的成年童话，不把现实中的家人分别和父亲被囚改写成已经解决。&lt;br/&gt;修改图不会自动改变游戏；可以改文案、重接箭头、添加前置条件，然后将这份设计落实到故事代码。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#454545;fontSize=17;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1740" width="2050" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
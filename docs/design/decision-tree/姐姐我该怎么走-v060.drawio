<mxfile host="app.diagrams.net"><diagram id="story-v060" name="0.6.0 六条命运"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="OPEN" value="最后一点粮食&#xa;父亲已被捕，全家知情&#xa;姐姐握着剪刀" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="650" y="10" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="CUT" value="是否剪发？" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="AID" value="托买、赊账、变卖家当、求援&#xa;接连失败" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="150" y="260" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="MARRIAGE" value="亲戚提出婚事&#xa;提供粮食与住处" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="150" y="390" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="HUNGER" value="家当卖尽&#xa;长期饥饿加重" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="10" y="560" width="230" height="75" as="geometry"/></mxCell>
<mxCell id="WEDDING" value="姐姐迫于生存压力&#xa;接受婚事、离家" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="280" y="560" width="230" height="75" as="geometry"/></mxCell>
<mxCell id="E01" value="01 没有升起的炊烟&#xa;家中四人相继饿死&#xa;父亲不在" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#202529;fontColor=#FFFFFF;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="10" y="710" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="E02" value="02 姐姐出嫁的那一天&#xa;其他三人活下来&#xa;饭桌少了姐姐" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#202529;fontColor=#FFFFFF;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="280" y="710" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="WORK" value="亡兄旧衣、小帽、阿提什&#xa;与莱拉互助谋生，仍受欺负" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="WAR" value="爆炸、军车与商铺关闭&#xa;两人即将被人流冲散" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1000" y="380" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="WHERE" value="混乱中先往哪里走？" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="TRUCK" value="先回家，带母亲、姐姐、幼弟&#xa;赶上舅舅的露天货车" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="630" y="670" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="E04" value="04 离城的四个人&#xa;父亲仍被囚，莱拉去向不明" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#202529;fontColor=#FFFFFF;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="630" y="820" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="GATE" value="拉住莱拉一同到城门&#xa;被当作男孩征用" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1000" y="670" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="MARCH" value="被迫搬运、传令&#xa;离家越来越远" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="280" height="75" as="geometry"/></mxCell>
<mxCell id="E03" value="03 没有返程的路&#xa;最后被送向前线" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#202529;fontColor=#FFFFFF;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1000" y="930" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="FIND" value="先失散，再逆着人流&#xa;在封锁的街口找到莱拉" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1400" y="670" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="HIT" value="巡查认出女主，女孩身份暴露&#xa;遭打昏迷，莱拉呼喊" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1400" y="800" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="TALE" value="梦中成为苏莱曼、寻找种子&#xa;恐惧、受伤、得到帮助" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1400" y="930" width="280" height="80" as="geometry"/></mxCell>

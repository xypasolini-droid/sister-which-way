<mxCell id="VOICES" value="梦中家人叫她回家&#xa;现实莱拉叫她醒来" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1400" y="1180" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="SPRING" value="种子发芽，村庄丰收&#xa;父亲、姐姐、幼弟与亡兄团聚" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F6F6F6;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1170" y="1360" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="E05" value="05 没有醒来的春天 · 梦境&#xa;现实中始终没有醒来&#xa;现实家人去向未知" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#202529;fontColor=#FFFFFF;strokeColor=#9DA2A6;" vertex="1" parent="1"><mxGeometry x="1170" y="1500" width="270" height="110" as="geometry"/></mxCell>
